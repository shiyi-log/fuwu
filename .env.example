DJANGO_SECRET_KEY=change-this-for-local-use
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FUWU_PORT=8000
FRONTEND_PORT=3331
FUWU_IMAGE_TAG=0.0.3
FUWU_STORAGE=memory
FUWU_S3_BUCKET=your-bucket
FUWU_S3_REGION=your-region-1
FUWU_S3_PREFIX=releases
FUWU_S3_PUBLIC_READS=1
FUWU_S3_ENDPOINT=https://s3.your-region-1.amazonaws.com
FUWU_S3_TIMEOUT=20
FUWU_AUTH_TOKENS={}
FUWU_ALLOW_ROLLBACK_NON_SUPERADMIN=0
AWS_CREDENTIALS_FILE=/run/secrets/aws_credentials
MYSQL_DATABASE=fuwu
MYSQL_USER=fuwu
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
