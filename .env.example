# Replace with a random value of at least 32 characters before starting Compose.
DJANGO_SECRET_KEY=change-this-for-local-use
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Host port; the API container continues to listen on 8000 internally.
FUWU_PORT=8088
FUWU_API_BIND=127.0.0.1
FRONTEND_PORT=3331
FUWU_FRONTEND_BIND=127.0.0.1
FUWU_IMAGE_TAG=0.1.1
FUWU_STORAGE=memory
FUWU_S3_BUCKET=your-bucket
FUWU_S3_REGION=your-region-1
FUWU_S3_PREFIX=releases
FUWU_S3_PUBLIC_READS=1
FUWU_S3_ENDPOINT=https://s3.your-region-1.amazonaws.com
FUWU_S3_TIMEOUT=20
FUWU_AUTH_TOKENS={}
FUWU_ALLOW_ROLLBACK_NON_SUPERADMIN=0
# Exact peer CIDR(s) of the outer TLS proxy as seen by the frontend container.
FUWU_TRUSTED_PROXY_CIDRS=
FUWU_TRUST_X_FORWARDED_PROTO=0
# SMTP is required for the public email password-recovery flow.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
AWS_CREDENTIALS_FILE=/run/secrets/aws_credentials
MYSQL_DATABASE=fuwu
MYSQL_USER=fuwu
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
