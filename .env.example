# fuwu local/container defaults. Copy to .env before docker compose up.
FUWU_PORT=8000
FRONTEND_PORT=3331
FUWU_STORAGE=memory
FUWU_S3_BUCKET=heyue
FUWU_S3_REGION=ap-southeast-1
FUWU_S3_PREFIX=releases
FUWU_S3_PUBLIC_READS=1
FUWU_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

# JSON map of opaque bearer tokens to permissions. Use a secret manager in production.
# This value is intentionally empty by default; every API request then returns 401.
FUWU_AUTH_TOKENS={}
FUWU_ALLOW_ROLLBACK_NON_SUPERADMIN=0

# Optional root-owned 0600 file path. Do not commit the file or put credentials in frontend/.env.
AWS_CREDENTIALS_FILE=./secrets/aws_credentials

# The first implementation persists locally in SQLite; these services define the replacement boundary.
MYSQL_DATABASE=fuwu
MYSQL_USER=fuwu
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
