VITE_BASE=/
VITE_APP_TITLE=fuwu 发行管理 v0.0.1
VITE_APP_VERSION=0.0.1

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 生产环境使用同源反向代理到 fuwu API，不依赖 Vben mock 服务
VITE_NITRO_MOCK=false

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
